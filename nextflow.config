// ─── Default parameters ───────────────────────────────────────────────────────
params {
    // I/O
    input_dir          = null
    output_dir         = "results"
    fastq_pattern      = "*{_R,_}{1,2}*.fastq.gz"
    single_end         = false

    // Read QC & trimming
    adapter_file       = null          // Optional FASTA of adapters; auto-detect if null
    min_read_length    = 50
    min_base_quality   = 20

    // Genome size estimation
    prescreen_genome_size_check = null // Max allowed genome size in bp; skip check if null

    // Downsampling (rasusa)
    depth_cutoff       = null          // Target coverage depth, e.g. 100; null = skip

    // Taxonomic screening (Kraken2)
    run_kraken2        = true
    kraken2_db         = null          // Path to Kraken2 DB; required if run_kraken2=true
    kraken2_min_pct    = 1.0           // Min % to include a taxon in the summary report

    // Assembly (SPAdes)
    spades_mode        = "careful"     // careful | meta | plasmid | rna
    min_contig_length  = 500
    spades_extra_args  = ""

    // Assembly QC
    run_checkm2        = true
    checkm2_db_path    = null          // Path to CheckM2 DIAMOND db (auto-download if null)

    // ── Functional annotation ──────────────────────────────────────────────
    // annotation_tool: 'prokka' | 'bakta' | 'both' | 'pgap' | 'none'
    annotation_tool     = 'none'

    // Shared metadata (used by Prokka, Bakta and PGAP)
    annotation_genus    = null
    annotation_species  = null
    annotation_strain   = null
    locus_tag_prefix    = null
    genome_topology     = 'linear'

    // Prokka-specific
    prokka_proteins     = null         // Optional FASTA of trusted proteins

    // Bakta-specific
    bakta_db            = null         // Path to Bakta DB (required if annotation_tool includes bakta)
    bakta_db_type       = 'full'       // 'full' | 'light'
    bakta_proteins      = null         // Optional trusted proteins FASTA

    // PGAP-specific
    pgap_container_runtime = 'prep_only'  // 'singularity' | 'docker' | 'prep_only'
    pgap_py_path           = 'pgap.py'    // Path to pgap.py wrapper script
    pgap_extra_args        = '--ignore-all-errors'

    // Contact info for PGAP submol.yaml (required by PGAP, optional for Prokka)
    contact_last_name    = null
    contact_first_name   = null
    contact_email        = null
    organization         = null
    department           = null

    // Reporting
    multiqc_config     = null

    // Resource caps (overrideable per cluster)
    max_cpus   = 16
    max_memory = "64.GB"
    max_time   = "24.h"

    // SLURM (used in slurm profile)
    slurm_queue        = "normal"
    slurm_queue_high   = null          // Falls back to slurm_queue if null
    slurm_account      = null
}

// ─── Conda / Mamba ────────────────────────────────────────────────────────────
conda {
    enabled    = true
    useMamba   = true
    cacheDir   = "${HOME}/.nextflow/conda_envs"
    createTimeout = "60 min"
}

// ─── Default executor (local) ─────────────────────────────────────────────────
// Override with: -profile slurm   or   bash run_pipeline.sh --hpc
process.executor = 'local'

// ─── Sub-configs ──────────────────────────────────────────────────────────────
includeConfig 'conf/base.config'

// ─── Profiles ─────────────────────────────────────────────────────────────────
// Default: runs locally (no profile needed).
// Use -profile slurm  or  bash run_pipeline.sh --hpc  to submit to SLURM.
profiles {

    local {
        process.executor = 'local'
    }

    slurm {
        includeConfig 'conf/slurm.config'
    }

    test {
        params {
            input_dir       = "${projectDir}/test_input"
            output_dir      = "${projectDir}/test_output"
            fastq_pattern   = "*{_R,_}{1,2}*.fastq.gz"
            run_checkm2     = false
            run_kraken2     = false
            annotation_tool = 'none'
            max_cpus        = 4
            max_memory      = "8.GB"
        }
    }
}

// ─── Pipeline metadata ────────────────────────────────────────────────────────
manifest {
    name            = 'pipa'
    author          = 'AGROSAVIA Bioinformatics — PIPA'
    description     = 'Pipeline for Integrated Prokaryotic Assembly (PIPA) · Mamba · local by default, SLURM opt-in'
    version         = '1.0.0'
    nextflowVersion = '>=23.04.0'
    mainScript      = 'main.nf'
}

// ─── Reports ──────────────────────────────────────────────────────────────────
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

report {
    enabled   = true
    file      = "${params.output_dir}/pipeline_info/report_${trace_timestamp}.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.output_dir}/pipeline_info/timeline_${trace_timestamp}.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.output_dir}/pipeline_info/trace_${trace_timestamp}.tsv"
    overwrite = true
    fields    = 'task_id,name,status,exit,realtime,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar'
}
dag {
    enabled   = true
    file      = "${params.output_dir}/pipeline_info/dag_${trace_timestamp}.html"
    overwrite = true
}
