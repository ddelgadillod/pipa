// conf/slurm.config — SLURM-specific executor settings

process {
    executor = 'slurm'

    // Default queue — override with: --slurm_queue <name>
    queue = { params.slurm_queue }

    // Optional SBATCH extras: account, QOS, constraints, etc.
    clusterOptions = {
        def opts = []
        if (params.slurm_account) opts << "--account=${params.slurm_account}"
        opts.join(' ')
    }

    // High-priority jobs can go to a different partition if configured
    withLabel: process_high {
        queue = { params.slurm_queue_high ?: params.slurm_queue }
    }
}

executor {
    name            = 'slurm'
    queueSize       = 100        // max concurrent jobs submitted
    submitRateLimit = '20/1min'  // avoid SLURM overload
    pollInterval    = '30 sec'
    exitReadTimeout = '15 min'   // wait for exit file after job ends
    jobName         = { "${task.process.tokenize(':').last()}_${task.tag}" }
}
